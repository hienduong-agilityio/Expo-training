{
  "name": "stylish-ecommerce",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "web": "expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "storybook": "EXPO_PUBLIC_ENVIRONMENT=storybook expo start",
    "storybook:web": "storybook dev -p 6006",
    "storybook-generate": "sb-rn-get-stories",
    "build:web": "rm -rf dist && expo export --platform web",
    "build:storybook:web": "rm -rf dist && storybook build -o dist",
    "atlas": "rm -rf .expo/atlas && EXPO_ATLAS=1 expo export --platform all && npx expo-atlas",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "update": "eas update:configure",
    "deploy:web": "yarn build:web && eas deploy --prod",
    "deploy:storybook:web": "yarn build:storybook:web && eas deploy --alias storybook",
    "lint": "expo lint",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "type-check": "yarn tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "validate": "yarn type-check && yarn lint && yarn test",
    "doctor": "npx expo-doctor --verbose",
    "install:fix": "npx expo install --fix",
    "reset-project": "node ./scripts/reset-project.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "^8.6.0",
    "@react-native-community/slider": "^5.1.2",
    "@react-navigation/bottom-tabs": "^7.7.3",
    "@react-navigation/elements": "^2.8.1",
    "@react-navigation/native": "^7.1.28",
    "@shopify/flash-list": "2.0.2",
    "@storybook/addon-ondevice-actions": "^10.2.3",
    "@storybook/addon-ondevice-controls": "^10.2.3",
    "@storybook/react-native": "^10.2.3",
    "@tanstack/react-query": "^5.62.11",
    "expo": "~55.0.4",
    "expo-build-properties": "~55.0.9",
    "expo-constants": "~55.0.7",
    "expo-dev-client": "~55.0.9",
    "expo-device": "~55.0.9",
    "expo-file-system": "~55.0.7",
    "expo-font": "~55.0.4",
    "expo-glass-effect": "~55.0.7",
    "expo-image": "~55.0.5",
    "expo-insights": "~55.0.10",
    "expo-linking": "~55.0.7",
    "expo-router": "~55.0.3",
    "expo-splash-screen": "~55.0.10",
    "expo-status-bar": "~55.0.4",
    "expo-symbols": "~55.0.4",
    "expo-system-ui": "~55.0.9",
    "expo-updates": "~55.0.12",
    "expo-web-browser": "~55.0.9",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.2",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-performance": "^5.1.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "^15.15.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.2",
    "storybook": "^10.2.14",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@chromatic-com/storybook": "^5.0.1",
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@storybook/addon-a11y": "^10.2.14",
    "@storybook/addon-docs": "^10.2.14",
    "@storybook/addon-vitest": "^10.2.14",
    "@storybook/react-native-web-vite": "^10.2.14",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "babel-loader": "^8.4.1",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~55.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-storybook": "^10.2.14",
    "expo-atlas": "^0.4.0",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.9",
    "lint-staged": "^16.2.7",
    "playwright": "^1.58.2",
    "prettier": "^3.8.1",
    "storybook": "^10.2.14",
    "typescript": "~5.9.2",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "hermes-compiler": "250829098.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "resolutions": {
    "hermes-compiler": "250829098.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "private": true
}
