# .env.development
# localhost is OK for iOS Simulator / web. Android emulator uses 10.0.2.2 at runtime (see src/constants/api.ts).
API_BASE_URL=http://localhost:1337/api
STRAPI_BASE_URL=http://localhost:1337
EXPO_PUBLIC_API_BASE_URL=http://localhost:1337/api
EXPO_PUBLIC_STRAPI_BASE_URL=http://localhost:1337
# When using .env.local with cloud Strapi, duplicate the same URLs as EXPO_PUBLIC_* for Metro.
# Optional: set true if you use adb reverse and need localhost on a physical Android device
# DISABLE_ANDROID_LOCALHOST_REWRITE=false
LOAD_STORYBOOK=true

# .env.production
API_BASE_URL=http://your-production-url.com/api
STRAPI_BASE_URL=http://your-production-url.com
REQUIRE_HTTPS=true
LOAD_STORYBOOK=true
