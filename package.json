{
  "name": "StylishEcommerce",
  "version": "0.0.2",
  "private": true,
  "main": "index.js",
  "scripts": {
    "prepare": "husky install",
    "start": "expo start",
    "start:clear": "expo start -c",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "clean:android": "cd android && ./gradlew clean && cd ..",
    "test": "jest",
    "test:coverage": "jest --coverage --watchAll",
    "test:deep-link:android": "adb shell am start -W -a android.intent.action.VIEW -d \"stylish://products/itgkaxmarsxs4vxpxx3fiad5\" com.reactnativetemplate",
    "test:deep-link:ios": "xcrun simctl openurl booted \"stylish://products/itgkaxmarsxs4vxpxx3fiad5\"",
    "lint": "eslint .",
    "lint:check": "eslint . && tsc --noEmit",
    "lint:fix": "eslint --fix .",
    "format": "prettier \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "prettier:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "prettier:fix": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "analyze:bundle": "node scripts/analyze-bundle.js json",
    "analyze:bundle:html": "node scripts/analyze-bundle.js html",
    "analyze:bundle:tsv": "node scripts/analyze-bundle.js tsv",
    "storybook-generate": "sb-rn-get-stories",
    "doctor": "npx expo-doctor --verbose",
    "eas-build-pre-install": "bash scripts/eas-write-google-services.sh",
    "install:check": "expo install --check",
    "eas:build:android:preview": "eas build --platform android --profile preview",
    "eas:build:android:production": "eas build --platform android --profile production",
    "eas:build:android:local:production": "export GOOGLE_SERVICES_JSON=\"$PWD/config/google-services.json\" GOOGLE_SERVICE_INFO_PLIST=\"$PWD/config/GoogleService-Info.plist\" && eas build --platform android --profile production --local",
    "eas:build:android:local:dev": "export GOOGLE_SERVICES_JSON=\"$PWD/config/google-services.json\" GOOGLE_SERVICE_INFO_PLIST=\"$PWD/config/GoogleService-Info.plist\" && eas build --platform android --profile development --local",
    "eas:update:preview": "scripts/eas-update-publish.sh preview",
    "eas:update:production": "scripts/eas-update-publish.sh production",
    "eas:update:promote": "eas update:republish --branch preview --destination-branch production",
    "eas:update:rollback": "eas update:rollback --channel production",
    "eas:update:status": "scripts/eas-update-status.sh"
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.9",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.90.7",
    "expo": "~55.0.15",
    "expo-application": "~55.0.14",
    "expo-build-properties": "~55.0.13",
    "expo-constants": "~55.0.14",
    "expo-dev-client": "~55.0.27",
    "expo-device": "~55.0.15",
    "expo-font": "~55.0.6",
    "expo-image": "~55.0.8",
    "expo-linking": "~55.0.13",
    "expo-network": "~55.0.13",
    "expo-notifications": "~55.0.19",
    "expo-router": "~55.0.12",
    "expo-secure-store": "~55.0.13",
    "expo-splash-screen": "~55.0.18",
    "expo-updates": "~55.0.20",
    "qs": "^6.13.0",
    "react": "19.2.0",
    "react-native": "0.83.6",
    "react-native-performance": "^6.0.0",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-export-namespace-from": "^7.27.1",
    "@react-native/eslint-config": "0.83.4",
    "@react-native/metro-config": "0.83.4",
    "@react-native/typescript-config": "0.83.4",
    "@rozenite/metro": "^1.2.0",
    "@rozenite/network-activity-plugin": "^1.2.0",
    "@rozenite/performance-monitor-plugin": "^1.2.0",
    "@rozenite/tanstack-query-plugin": "^1.2.0",
    "@storybook/addon-actions": "^7.6.18",
    "@storybook/addon-ondevice-actions": "^7.6.18",
    "@storybook/addon-ondevice-backgrounds": "7.6.18",
    "@storybook/addon-ondevice-notes": "7.6.18",
    "@storybook/react-native": "7.6.18",
    "@testing-library/react-native": "12.5.0",
    "@types/jest": "^29.5.14",
    "@types/qs": "^6.14.0",
    "@types/react": "~19.2.10",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "5.0.2",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "5.1.3",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.1.0-canary-bcf97c75-20251215",
    "eslint-plugin-testing-library": "6.2.2",
    "husky": "9.0.11",
    "jest": "29.7.0",
    "lint-staged": "15.2.2",
    "prettier": "3.2.5",
    "react-native-bundle-discovery": "^1.2.4",
    "react-test-renderer": "19.1.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
