{
  "name": "StylishEcommerce",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "prepare": "husky install",
    "start": "react-native start",
    "metro": "react-native start --reset-cache",
    "android": "react-native run-android",
    "android:dev": "ENVFILE=.env.development react-native run-android",
    "android:prod": "ENVFILE=.env.production react-native run-android",
    "android:release": "cd android && ./gradlew assembleRelease && cd ..",
    "android:measure:start": "adb shell am start -W -n com.reactnativetemplate/com.reactnativetemplate.MainActivity",
    "ios": "react-native run-ios",
    "clean": "cd android && ./gradlew clean && cd .. && cd ios && xcodebuild clean && cd ..",
    "clean:android": "cd android && ./gradlew clean && cd ..",
    "clean:ios": "cd ios && xcodebuild clean && cd ..",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:deep-link:android": "adb shell am start -W -a android.intent.action.VIEW -d \"stylish://products/itgkaxmarsxs4vxpxx3fiad5\" com.reactnativetemplate",
    "test:deep-link:ios": "xcrun simctl openurl booted \"stylish://products/itgkaxmarsxs4vxpxx3fiad5\"",
    "lint": "eslint .",
    "lint:check": "eslint . && tsc --noEmit",
    "lint:fix": "eslint --fix .",
    "prettier": "prettier \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "prettier:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "prettier:fix": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "analyze:bundle": "node scripts/analyze-bundle.js json",
    "analyze:bundle:html": "node scripts/analyze-bundle.js html",
    "analyze:bundle:tsv": "node scripts/analyze-bundle.js tsv",
    "storybook-generate": "sb-rn-get-stories"
  },
  "dependencies": {
    "@notifee/react-native": "^9.1.8",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.0.1",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-firebase/app": "^23.7.0",
    "@react-native-firebase/messaging": "^23.7.0",
    "@react-native/new-app-screen": "0.81.4",
    "@react-navigation/bottom-tabs": "^7",
    "@react-navigation/native": "^7",
    "@react-navigation/native-stack": "^7",
    "@tanstack/react-query": "^5.90.7",
    "react": "^19.2.3",
    "react-native": "^0.83.0",
    "react-native-config": "1.5.1",
    "react-native-device-info": "^15.0.1",
    "react-native-fast-image": "^8.6.3",
    "react-native-keychain": "^10.0.0",
    "react-native-permissions": "^5.4.4",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.0.0",
    "react-native-svg": "^15.14.0",
    "source-map-explorer": "^2.5.3",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-export-namespace-from": "^7.27.1",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.2",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.81.4",
    "@react-native/eslint-config": "0.81.4",
    "@react-native/metro-config": "0.81.4",
    "@react-native/typescript-config": "0.81.4",
    "@storybook/addon-actions": "^7.6.18",
    "@storybook/addon-ondevice-actions": "^7.6.18",
    "@storybook/addon-ondevice-backgrounds": "7.6.18",
    "@storybook/addon-ondevice-notes": "7.6.18",
    "@storybook/react-native": "7.6.18",
    "@testing-library/react-native": "12.5.0",
    "@types/jest": "^29.5.13",
    "@types/qs": "^6.14.0",
    "@types/react": "^19.1.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "5.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "5.1.3",
    "eslint-plugin-react-hooks": "^7.1.0-canary-bcf97c75-20251215",
    "eslint-plugin-testing-library": "6.2.2",
    "husky": "9.0.11",
    "jest": "29.7.0",
    "lint-staged": "15.2.2",
    "prettier": "3.2.5",
    "react-test-renderer": "19.1.0",
    "reactotron-react-native": "^5.1.18",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
